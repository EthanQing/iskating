# iSkating ignore rules
# Keep source, Qt UI/resource files, and real assets in Git.
# Ignore generated build output and machine-local editor state.

# ---- local workspace / editor state ----
.agents/
.codex/
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- Visual Studio / generated project files ----
*.sln
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vc.db
*.opendb
*.ipch
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.vcxproj.*.user
*.vcproj
*.vcproj.*

# ---- Qt / qmake generated files ----
.qmake.stash
*.pro.user
*.pro.user.*
Makefile
Makefile.*
moc/
rcc/
ui/
obj/
qrc_*.cpp
moc_*.cpp
ui_*.h

# ---- build output directories ----
build/
build-*/
debug/
release/
Debug/
Release/
x64/
bin/
out/
dist/

# ---- compiled / binary / debug artifacts ----
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.exp
*.ilk
*.pdb
*.idb
*.res
*.rcc
*.moc
*.pch
*.manifest
*.recipe
*.tlog
*.lastbuildstate
*.log
*.engine

# ---- Node / frontend generated files ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
coverage/

# ---- OS / editor temporary files ----
.agents/
.codex/
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*~
