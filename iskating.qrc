<RCC>
    <qresource prefix="/public">
        <file alias="skating.png">vue2-empty/public/skating.png</file>
        <file alias="pose-a.png">vue2-empty/public/pose-a.png</file>
        <file alias="pose-b.png">vue2-empty/public/pose-b.png</file>
    </qresource>
    <qresource prefix="/styles">
        <file alias="iskating.qss">styles/iskating.qss</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="sidebar-after.png">images/sidebar_after.png</file>
        <file alias="topbar-after.png">images/topbar_after.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="exit_fullscreen.svg">icons/exit_fullscreen.svg</file>
        <file alias="fullscreen.svg">icons/fullscreen.svg</file>
        <file alias="save.svg">icons/save.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="sidebar.svg">icons/sidebar.svg</file>
        <file alias="start_cap.svg">icons/start_cap.svg</file>
        <file alias="stop.svg">icons/stop.svg</file>
        <file alias="suspend.svg">icons/suspend.svg</file>
        <file alias="video.svg">icons/video.svg</file>
    </qresource>
</RCC>
