/* iSkating workstation design system */

/* Global */
QWidget {
    color: #F4F7FA;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
    background: transparent;
}
QMainWindow {
    background: #080B10;
}
QWidget#centralwidget {
    background: #080B10;
}
QDialog {
    background: #16212E;
}

/* Typography */
QLabel#brandTitleLabel,
QLabel#mainViewTitleLabel,
QLabel#athleteSectionLabel,
QLabel#trajectoryTitleLabel,
QLabel#settingsTitleLabel,
QLabel#historyTitleLabel,
QLabel#suggestionTitleLabel {
    color: #F4F7FA;
    font-size: 20px;
    font-weight: 600;
}
QLabel#brandTitleLabel {
    font-size: 16px;
    font-weight: 700;
}
QLabel#brandSubtitleLabel,
QLabel#athleteDetectionLabel,
QLabel#athleteSourceLabel,
QLabel#durationLabel,
QLabel#actionLabel,
QLabel#legendTitleLabel,
QLabel#suggestionSubtitleLabel {
    color: #7E8FA3;
    font-size: 12px;
}
QLabel#sidebarSectionLabel,
QLabel#sidebarToolsLabel,
QLabel#sidebarSystemLabel {
    color: #91A2B4;
    font-size: 12px;
    font-weight: 600;
    padding-top: 8px;
    border-top: 1px solid #243244;
}
QLabel#sidebarSectionLabel {
    padding-top: 0;
    border-top: none;
}
QLabel#focusTitleLabel,
QLabel#focusTitleLabelInline,
QLabel#systemStatusLabel,
QLabel#modelStatusLabel,
QLabel#storageStatusLabel,
QLabel#sessionTimeLabel,
QLabel#legendContentLabel {
    color: #B6C2D0;
    font-size: 12px;
}
QLabel#sessionRoundLabel {
    color: #F4F7FA;
    font-size: 20px;
    font-weight: 600;
}
QLabel#durationValueLabel,
QLabel#actionValueLabel {
    color: #F4F7FA;
    font-size: 18px;
    font-weight: 600;
}
QLabel#saveTipLabel {
    color: #FDB022;
}

/* Surface */
QFrame#sidebar {
    background: #0D131B;
    border-right: 1px solid #243244;
}
QFrame#inspector,
QFrame[role="surface"],
QFrame[role="panel"] {
    background: #111A24;
    border: none;
    border-radius: 8px;
}
QFrame#leftCard {
    background: transparent;
    border: none;
}
QFrame#opsCard {
    background: #111A24;
    border: none;
    border-radius: 10px;
}
QFrame#trajectoryCard {
    background: #111A24;
    border: none;
    border-radius: 8px;
}
QScrollArea,
QScrollArea#cameraScrollArea,
QScrollArea#inspectorScroll {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget,
QScrollArea#cameraScrollArea > QWidget > QWidget,
QScrollArea#inspectorScroll > QWidget > QWidget {
    background: transparent;
}

/* Sidebar and navigation */
QLabel#brandLogoLabel,
QLabel#brandLogoLabelShell {
    background: #1D3040;
    border: 1px solid #31445A;
    border-radius: 8px;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 700;
}
QLabel#brandLogoLabelShell {
    background: transparent;
    border: none;
}
AnimatedButton[role="nav"],
QPushButton[role="nav"] {
    min-height: 40px;
    padding: 0 12px;
    border: none;
    border-radius: 7px;
    text-align: left;
}
AnimatedButton[role="nav"]:disabled,
QPushButton[role="nav"]:disabled {
    color: #536273;
}
QToolTip {
    padding: 6px 8px;
    border: 1px solid #31445A;
    border-radius: 5px;
    color: #F4F7FA;
    background: #192735;
}

/* Buttons */
AnimatedButton {
    min-height: 36px;
    padding: 0 12px;
}
AnimatedButton[variant="primary"] {
    min-height: 40px;
    font-weight: 600;
}
AnimatedButton[role="icon"] {
    min-width: 34px;
    min-height: 34px;
    padding: 0;
}
QPushButton {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #31445A;
    border-radius: 6px;
    color: #F4F7FA;
    background: #192735;
}
QPushButton:hover,
QToolButton:hover {
    background: #1D3040;
    border-color: #3D566F;
}
QPushButton:pressed,
QToolButton:pressed {
    background: #1D3042;
    border-color: #38BDF8;
}
QPushButton:focus,
QToolButton:focus {
    border-color: #38BDF8;
}
QPushButton[variant="primary"] {
    color: #081018;
    background: #0EA5E9;
    border-color: #38BDF8;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background: #38BDF8;
}
QPushButton[variant="primary"]:pressed {
    background: #0284C7;
}
QPushButton[variant="secondary"],
QPushButton[role="secondary"],
QPushButton[role="secondaryButton"] {
    color: #D5DEE8;
    background: #192735;
    border-color: #30445A;
}
QPushButton[variant="secondary"]:hover,
QPushButton[role="secondary"]:hover,
QPushButton[role="secondaryButton"]:hover {
    color: #F4F7FA;
    background: #1D3040;
    border-color: #3D566F;
}
QPushButton[variant="secondary"]:pressed,
QPushButton[role="secondary"]:pressed,
QPushButton[role="secondaryButton"]:pressed {
    background: #16212E;
}
QPushButton[variant="subtle"] {
    color: #C5D0DC;
    background: #151F2B;
    border-color: #2B3B4E;
}
QPushButton[variant="subtle"]:hover {
    color: #F4F7FA;
    background: #1A2A38;
    border-color: #3A526B;
}
QPushButton[variant="subtle"]:pressed {
    background: #1D3042;
}
QPushButton[variant="danger"] {
    color: #FFE4E1;
    background: #542925;
    border-color: #7E3934;
}
QPushButton[variant="danger"]:hover {
    background: #6E302C;
    border-color: #F97066;
}
QPushButton[variant="danger"]:pressed {
    background: #45201E;
}
QPushButton[variant="ghost"],
QPushButton[role="ghost"] {
    color: #B6C2D0;
    background: transparent;
    border-color: transparent;
}
QPushButton[variant="ghost"]:hover,
QPushButton[role="ghost"]:hover {
    color: #F4F7FA;
    background: #1D3040;
    border-color: #31445A;
}
QPushButton[variant="ghost"]:pressed,
QPushButton[role="ghost"]:pressed {
    background: #1D3042;
}
QPushButton[variant="secondary"]:focus,
QPushButton[role="secondary"]:focus,
QPushButton[role="secondaryButton"]:focus,
QPushButton[variant="subtle"]:focus,
QPushButton[variant="ghost"]:focus,
QPushButton[role="ghost"]:focus {
    border-color: #38BDF8;
}
QToolButton {
    min-width: 34px;
    min-height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #AFC0D0;
}
QPushButton:disabled,
QToolButton:disabled,
AnimatedButton:disabled,
QPushButton[variant="primary"]:disabled,
QPushButton[variant="secondary"]:disabled,
QPushButton[variant="subtle"]:disabled,
QPushButton[variant="danger"]:disabled,
QPushButton[variant="ghost"]:disabled,
QPushButton[role="secondary"]:disabled,
QPushButton[role="secondaryButton"]:disabled,
QPushButton[role="ghost"]:disabled {
    color: #536273;
    background: #0F141B;
    border-color: #243244;
}

/* Inputs */
QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit {
    min-height: 26px;
    padding: 5px 9px;
    border: 1px solid #31445A;
    border-radius: 5px;
    color: #F4F7FA;
    background: #0D141E;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QPlainTextEdit,
QTextEdit,
QListWidget,
QTableWidget {
    min-height: 34px;
    padding: 5px 9px;
    border: 1px solid #31445A;
    border-radius: 5px;
    color: #F4F7FA;
    background: #0D141E;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QPlainTextEdit,
QTextEdit {
    padding: 7px 9px;
}
QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #3D566F;
}
QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #38BDF8;
}
QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    color: #536273;
    background: #0F141B;
    border-color: #1A222D;
}
QLineEdit,
QPlainTextEdit,
QTextEdit {
    placeholder-text-color: #7E8FA3;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/chevron-down.svg);
}
QComboBox QAbstractItemView {
    padding: 4px;
    border: 1px solid #31445A;
    color: #F4F7FA;
    background: #192735;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}
QComboBox QAbstractItemView::item:hover {
    color: #F4F7FA;
    background: #1D3040;
}
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 10px;
    height: 10px;
    image: url(:/icons/chevron-up.svg);
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/icons/chevron-down.svg);
}
QCheckBox {
    spacing: 8px;
    color: #B6C2D0;
}
QCheckBox:disabled {
    color: #536273;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #31445A;
    border-radius: 4px;
    background: #0D141E;
}
QCheckBox::indicator:hover {
    border-color: #38BDF8;
}
QCheckBox::indicator:checked {
    border-color: #38BDF8;
    background: #0EA5E9;
    image: url(:/icons/check.svg);
}
QCheckBox::indicator:disabled {
    border-color: #1A222D;
    background: #0F141B;
}

/* Badges and states */
QLabel[role="badge"],
QLabel[role="status"] {
    min-height: 22px;
    padding: 2px 8px;
    border: 1px solid #31445A;
    border-radius: 11px;
    color: #B6C2D0;
    background: #192735;
}
QLabel[role="muted"] {
    color: #B6C2D0;
    font-size: 13px;
}
QLabel[role="sectionTitle"] {
    color: #D8E2EF;
    font-size: 15px;
    font-weight: 600;
}
QLabel[role="emptyBox"] {
    min-height: 150px;
    padding: 24px;
    border: none;
    border-radius: 8px;
    color: #B6C2D0;
    background: #111A24;
    font-size: 13px;
}
QLabel[state="online"],
QLabel[state="success"] {
    color: #32D583;
}
QLabel[state="warning"] {
    color: #FDB022;
}
QLabel[state="error"] {
    color: #F97066;
}
QLabel[state="muted"],
QLabel[state="offline"] {
    color: #7E8FA3;
}
QLabel#athleteIdentityLabel {
    color: #B6C2D0;
    font-size: 15px;
    font-weight: 600;
}
QLabel#athleteIdentityLabel[state="online"],
QLabel#athleteIdentityLabel[state="success"] {
    color: #32D583;
}
QLabel#athleteIdentityLabel[state="warning"] {
    color: #FDB022;
}
QLabel#athleteIdentityLabel[state="error"] {
    color: #F97066;
}
QLabel#athleteIdentityLabel[state="muted"],
QLabel#athleteIdentityLabel[state="offline"] {
    color: #7E8FA3;
}

/* Video and camera sources */
VideoOpenGLWidget {
    background: #111A24;
    border: 1px solid #243244;
    border-radius: 6px;
}
VideoOpenGLWidget[sourceTile="true"] {
    border-radius: 5px;
}
VideoOpenGLWidget[selected="true"] {
    border-color: #38BDF8;
}

/* Training */
QLabel#mainViewTitleLabel {
    font-size: 20px;
}
QLabel#currentAthleteNameLabel {
    color: #F4F7FA;
    font-size: 22px;
    font-weight: 600;
}
QLabel#athleteSourceLabel,
QLabel#athleteDetectionLabel,
QLabel#durationValueLabel,
QLabel#speedStatusLabel,
QLabel#modelStatusLabel {
    font-size: 14px;
}
QLabel#trajectoryTitleLabel,
QLabel#athleteSectionLabel {
    color: #B6C2D0;
    font-size: 14px;
    font-weight: 600;
}
QProgressBar {
    min-height: 6px;
    border: none;
    border-radius: 3px;
    background: #243244;
}
QProgressBar::chunk {
    border-radius: 3px;
    background: #38BDF8;
}

/* Trajectory */
TrajectoryWidget {
    background: #111A24;
}
QFrame#trajectoryToolbar,
QWidget#trajectoryToolbar {
    background: transparent;
}

/* Scrollbars */
QScrollBar:vertical {
    width: 7px;
    margin: 1px;
    background: transparent;
}
QScrollBar:horizontal {
    height: 7px;
    margin: 1px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 24px;
    border-radius: 3px;
    background: #31445A;
}
QScrollBar::handle:horizontal {
    min-width: 24px;
    border-radius: 3px;
    background: #31445A;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #3D566F;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: transparent;
}

/* Menus and dialogs */
QMenu {
    padding: 5px;
    border: 1px solid #31445A;
    border-radius: 6px;
    color: #F4F7FA;
    background: #192735;
}
QMenu::item {
    min-height: 28px;
    padding: 4px 24px 4px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    color: #F4F7FA;
    background: #1D3042;
}
QMenu::separator {
    height: 1px;
    margin: 5px 4px;
    background: #243244;
}
QDialog QLabel {
    color: #F4F7FA;
}
QDialogButtonBox QPushButton {
    min-width: 84px;
}
QHeaderView::section {
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #31445A;
    color: #B6C2D0;
    background: #192735;
}
QTableWidget {
    gridline-color: #243244;
}

/* Modal dialogs */
QDialog#framelessDialog {
    color: #F4F7FA;
    background: #16212E;
    border: 1px solid #3D566F;
}
QDialog#framelessDialog QWidget#dialogTitleBar {
    background: #192735;
    border-bottom: 1px solid #31445A;
}
QDialog#framelessDialog QLabel#dialogTitleLabel {
    color: #F4F7FA;
    font-size: 14px;
    font-weight: 600;
}
QDialog#framelessDialog QWidget#dialogContent {
    background: #16212E;
}
QDialog#framelessDialog QPushButton#dialogCloseButton {
    min-width: 28px;
    min-height: 24px;
    max-width: 28px;
    max-height: 24px;
    padding: 0;
    border: none;
    background: transparent;
    color: #AFC0D0;
    font-size: 18px;
}
QDialog#framelessDialog QPushButton#dialogCloseButton:hover {
    color: #FFFFFF;
    background: #5A262B;
}

/* System settings structure */
QDialog#framelessDialog QWidget#settingsBody {
    background: #16212E;
}
QDialog#framelessDialog QWidget#settingsNavigation {
    background: #0D131B;
    border-radius: 10px;
}
QDialog#framelessDialog QLabel#navigationTitle {
    color: #F4F7FA;
    font-size: 18px;
    font-weight: 600;
    padding: 4px 14px;
}
QDialog#framelessDialog QStackedWidget#settingsPages,
QDialog#framelessDialog QScrollArea#settingsPage,
QDialog#framelessDialog QScrollArea#settingsPage > QWidget > QWidget {
    border: none;
    background: #16212E;
}
QDialog#framelessDialog QLabel#pageTitle {
    color: #F4F7FA;
    font-size: 22px;
    font-weight: 600;
}
QDialog#framelessDialog QLabel#pageDescription,
QDialog#framelessDialog QLabel#settingDescription,
QDialog#framelessDialog QLabel#actionStatus {
    color: #7E8FA3;
    font-size: 13px;
}
QDialog#framelessDialog QLabel#sectionTitle {
    color: #F4F7FA;
    font-size: 16px;
    font-weight: 600;
    padding-top: 4px;
}
QDialog#framelessDialog QLabel#settingLabel,
QDialog#framelessDialog QLabel#cameraLabel {
    color: #B6C2D0;
}
QDialog#framelessDialog QWidget#settingsBody QLineEdit,
QDialog#framelessDialog QWidget#settingsBody QComboBox,
QDialog#framelessDialog QWidget#settingsBody QSpinBox {
    min-height: 36px;
    max-height: 36px;
    padding: 0 10px;
    border: 1px solid #31445A;
    border-radius: 6px;
    color: #F4F7FA;
    background: #0D141E;
    selection-background-color: #20374A;
}
QDialog#framelessDialog QWidget#settingsBody QComboBox {
    padding-right: 28px;
}
QDialog#framelessDialog QWidget#settingsBody QLineEdit:hover,
QDialog#framelessDialog QWidget#settingsBody QComboBox:hover,
QDialog#framelessDialog QWidget#settingsBody QSpinBox:hover {
    border-color: #3D566F;
    background: #111A24;
}
QDialog#framelessDialog QWidget#settingsBody QLineEdit:focus,
QDialog#framelessDialog QWidget#settingsBody QComboBox:focus,
QDialog#framelessDialog QWidget#settingsBody QSpinBox:focus {
    border-color: #38BDF8;
    background: #111A24;
}
QDialog#framelessDialog QWidget#settingsBody QCheckBox {
    min-height: 36px;
    color: #B6C2D0;
    spacing: 8px;
}
QDialog#framelessDialog QLabel#storageStatus {
    min-height: 52px;
    padding: 12px;
    border-radius: 8px;
    color: #B6C2D0;
    background: #111A24;
}
QDialog#framelessDialog QWidget#settingsBody QTableWidget {
    border: none;
    border-radius: 8px;
    color: #F4F7FA;
    background: #111A24;
    alternate-background-color: #16212E;
    gridline-color: #243244;
}
QTableWidget#competitionTable::item:selected {
    background-color: #1D3042;
    color: #F4F7FA;
    border-left: 3px solid #38BDF8;
}
QListWidget#historySessionList::item:selected {
    background-color: #1D3042;
    color: #F4F7FA;
    border-left: 3px solid #38BDF8;
}
QDialog#framelessDialog QWidget#settingsBody QHeaderView::section {
    min-height: 34px;
    padding: 4px 7px;
    border: none;
    border-right: 1px solid #31445A;
    border-bottom: 1px solid #31445A;
    color: #B6C2D0;
    background: #192735;
}
QDialog#framelessDialog QWidget#settingsActionBar {
    border-top: 1px solid #31445A;
    background: #16212E;
}
QDialog#framelessDialog QWidget#settingsBody QLineEdit:disabled,
QDialog#framelessDialog QWidget#settingsBody QComboBox:disabled,
QDialog#framelessDialog QWidget#settingsBody QSpinBox:disabled {
    color: #536273;
    background: #0F141B;
    border-color: #1A222D;
}
QDialog#framelessDialog QWidget#settingsBody QCheckBox:disabled {
    color: #536273;
}

/* Reworked workspace */
QSplitter#workspaceSplitter {
    background: transparent;
}
QSplitter#workspaceSplitter::handle {
    width: 5px;
    background: transparent;
}
QSplitter#workspaceSplitter::handle:hover {
    background: #243244;
}
QWidget#cameraGridContainer {
    background: transparent;
}
/* History */
QLabel#historyTitleLabel {
    font-size: 22px;
}
QLabel#historySubtitleLabel {
    color: #B6C2D0;
    font-size: 13px;
}
QFrame#historySearchPanel {
    background: #111A24;
    border: none;
    border-radius: 10px;
}
QFrame#summarySessionsCard,
QFrame#summaryActionsCard,
QFrame#summaryAvgCard,
QFrame#summaryBestCard {
    background: transparent;
    border: none;
    border-radius: 0;
}
QLabel#summarySessionsLabel,
QLabel#summaryActionsLabel,
QLabel#summaryAvgLabel,
QLabel#summaryBestLabel {
    color: #B6C2D0;
    font-size: 13px;
}
QLabel#summarySessionsValue,
QLabel#summaryActionsValue,
QLabel#summaryAvgValue,
QLabel#summaryBestValue {
    color: #F4F7FA;
    font-size: 15px;
    font-weight: 600;
}
QFrame[role="historyItem"] {
    background: #111A24;
    border: none;
    border-bottom: 1px solid #243244;
    border-radius: 0;
}
QLabel[role="scoreTag"] {
    min-height: 24px;
    padding: 0 8px;
    border: none;
    border-radius: 12px;
    color: #B6C2D0;
    background: #192735;
}
QFrame#historyMoreFilters {
    background: #0D131B;
    border: none;
    border-radius: 7px;
}
QWidget#historyPager {
    background: transparent;
}
QLabel#historyEmptyTitle {
    color: #F4F7FA;
    font-size: 16px;
    font-weight: 600;
}
QLabel#historyEmptyDescription {
    color: #B6C2D0;
    font-size: 13px;
}

/* Training settings drawer */
QDialog#trainingSettingsDrawer {
    color: #F4F7FA;
    background: #111A24;
    border: 1px solid #31445A;
}
QDialog#trainingSettingsDrawer QWidget#dialogTitleBar {
    min-height: 48px;
    max-height: 48px;
    background: #16212E;
    border-bottom: 1px solid #31445A;
}
QDialog#trainingSettingsDrawer QLabel#dialogTitleLabel {
    color: #F4F7FA;
    font-size: 16px;
    font-weight: 600;
}
QDialog#trainingSettingsDrawer QPushButton#dialogCloseButton {
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    color: #AFC0D0;
    font-size: 18px;
}
QDialog#trainingSettingsDrawer QPushButton#dialogCloseButton:hover {
    color: #F4F7FA;
    background: #5A262B;
}
QDialog#trainingSettingsDrawer QWidget#dialogContent,
QDialog#trainingSettingsDrawer QScrollArea#trainingSettingsScroll,
QDialog#trainingSettingsDrawer QScrollArea#trainingSettingsScroll > QWidget > QWidget {
    background: #111A24;
    border: none;
}
