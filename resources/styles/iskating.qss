/* iSkating workstation design system */

/* Global */
QWidget {
    color: #F4F7FA;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
    background: transparent;
}
QMainWindow {
    background: #080B10;
}
QWidget#centralwidget {
    background: #080B10;
}
QDialog {
    background: #101720;
}

/* Typography */
QLabel#brandTitleLabel,
QLabel#mainViewTitleLabel,
QLabel#athleteSectionLabel,
QLabel#trajectoryTitleLabel,
QLabel#settingsTitleLabel,
QLabel#historyTitleLabel,
QLabel#suggestionTitleLabel {
    color: #F4F7FA;
    font-size: 15px;
    font-weight: 600;
}
QLabel#brandTitleLabel {
    font-size: 16px;
    font-weight: 700;
}
QLabel#brandSubtitleLabel,
QLabel#sidebarSectionLabel,
QLabel#sidebarToolsLabel,
QLabel#athleteDetectionLabel,
QLabel#athleteSourceLabel,
QLabel#durationLabel,
QLabel#actionLabel,
QLabel#legendTitleLabel,
QLabel#suggestionSubtitleLabel {
    color: #667586;
    font-size: 11px;
}
QLabel#focusTitleLabel,
QLabel#focusTitleLabelInline,
QLabel#systemStatusLabel,
QLabel#modelStatusLabel,
QLabel#storageStatusLabel,
QLabel#sessionTimeLabel,
QLabel#legendContentLabel {
    color: #A2AFBF;
    font-size: 12px;
}
QLabel#sessionRoundLabel {
    color: #F4F7FA;
    font-size: 17px;
    font-weight: 600;
}
QLabel#durationValueLabel,
QLabel#actionValueLabel {
    color: #F4F7FA;
    font-size: 18px;
    font-weight: 600;
}
QLabel#saveTipLabel {
    color: #FDB022;
}

/* Surface */
QFrame#sidebar {
    background: #0C1118;
    border-right: 1px solid #202C3A;
}
QFrame#inspector,
QFrame#opsCard,
QFrame[role="surface"],
QFrame[role="panel"] {
    background: #101720;
    border: 1px solid #202C3A;
    border-radius: 8px;
}
QFrame#leftCard,
QFrame#trajectoryCard {
    background: transparent;
    border: none;
}
QFrame#trajectoryCard {
    border-top: 1px solid #202C3A;
    border-radius: 0;
}
QScrollArea,
QScrollArea#cameraScrollArea,
QScrollArea#inspectorScroll {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget,
QScrollArea#cameraScrollArea > QWidget > QWidget,
QScrollArea#inspectorScroll > QWidget > QWidget {
    background: transparent;
}

/* Sidebar and navigation */
QLabel#brandLogoLabel,
QLabel#brandLogoLabelShell {
    background: #1D3042;
    border: 1px solid #2D4054;
    border-radius: 8px;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 700;
}
QLabel#brandLogoLabelShell {
    background: transparent;
    border: none;
}
AnimatedButton[role="nav"],
QPushButton[role="nav"] {
    min-height: 40px;
    padding: 0 12px;
    border: none;
    border-radius: 7px;
    text-align: left;
}
AnimatedButton[role="nav"]:disabled,
QPushButton[role="nav"]:disabled {
    color: #667586;
}
QToolTip {
    padding: 6px 8px;
    border: 1px solid #2D4054;
    border-radius: 5px;
    color: #F4F7FA;
    background: #151E29;
}

/* Buttons */
AnimatedButton {
    min-height: 32px;
    padding: 0 12px;
}
AnimatedButton[role="icon"] {
    min-width: 34px;
    min-height: 34px;
    padding: 0;
}
AnimatedButton[variant="primary"] {
    font-weight: 600;
}
QPushButton {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid #2D4054;
    border-radius: 6px;
    color: #F4F7FA;
    background: #151E29;
}
QPushButton:hover,
QToolButton:hover {
    background: #192533;
    border-color: #3A526B;
}
QPushButton:pressed,
QToolButton:pressed {
    background: #1D3042;
    border-color: #38BDF8;
}
QPushButton:focus,
QToolButton:focus {
    border-color: #38BDF8;
}
QPushButton:disabled,
QToolButton:disabled,
AnimatedButton:disabled {
    color: #667586;
    background: #0F141B;
    border-color: #1A222D;
}
QPushButton[variant="primary"] {
    color: #081018;
    background: #0EA5E9;
    border-color: #38BDF8;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover {
    background: #38BDF8;
}
QPushButton[variant="primary"]:pressed {
    background: #0284C7;
}
QPushButton[variant="secondary"],
QPushButton[role="secondary"],
QPushButton[role="secondaryButton"] {
    color: #F4F7FA;
    background: #151E29;
    border-color: #2D4054;
}
QPushButton[variant="danger"] {
    color: #FFE4E1;
    background: #542925;
    border-color: #7E3934;
}
QPushButton[variant="danger"]:hover {
    background: #6E302C;
    border-color: #F97066;
}
QPushButton[variant="danger"]:pressed {
    background: #45201E;
}
QPushButton[variant="ghost"],
QPushButton[role="ghost"] {
    color: #A2AFBF;
    background: transparent;
    border-color: transparent;
}
QPushButton[variant="ghost"]:hover,
QPushButton[role="ghost"]:hover {
    background: #192533;
    border-color: #2D4054;
}
QPushButton[variant="ghost"]:pressed,
QPushButton[role="ghost"]:pressed {
    background: #1D3042;
}
QToolButton {
    min-width: 34px;
    min-height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #A2AFBF;
}

/* Inputs */
QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit {
    min-height: 22px;
    padding: 5px 9px;
    border: 1px solid #2D4054;
    border-radius: 5px;
    color: #F4F7FA;
    background: #0C1118;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QPlainTextEdit,
QTextEdit,
QListWidget,
QTableWidget {
    min-height: 34px;
    padding: 5px 9px;
    border: 1px solid #2D4054;
    border-radius: 5px;
    color: #F4F7FA;
    background: #0C1118;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QPlainTextEdit,
QTextEdit {
    padding: 7px 9px;
}
QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #3A526B;
}
QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #38BDF8;
}
QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    color: #667586;
    background: #0F141B;
    border-color: #1A222D;
}
QLineEdit,
QPlainTextEdit,
QTextEdit {
    placeholder-text-color: #667586;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/chevron-down.svg);
}
QComboBox QAbstractItemView {
    padding: 4px;
    border: 1px solid #2D4054;
    color: #F4F7FA;
    background: #151E29;
    selection-background-color: #1D3042;
    selection-color: #F4F7FA;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}
QComboBox QAbstractItemView::item:hover {
    color: #F4F7FA;
    background: #192533;
}
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 10px;
    height: 10px;
    image: url(:/icons/chevron-up.svg);
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/icons/chevron-down.svg);
}
QCheckBox {
    spacing: 8px;
    color: #A2AFBF;
}
QCheckBox:disabled {
    color: #667586;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2D4054;
    border-radius: 4px;
    background: #0C1118;
}
QCheckBox::indicator:hover {
    border-color: #38BDF8;
}
QCheckBox::indicator:checked {
    border-color: #38BDF8;
    background: #0EA5E9;
    image: url(:/icons/check.svg);
}
QCheckBox::indicator:disabled {
    border-color: #1A222D;
    background: #0F141B;
}

/* Badges and states */
QLabel[role="badge"],
QLabel[role="status"] {
    min-height: 22px;
    padding: 2px 8px;
    border: 1px solid #2D4054;
    border-radius: 11px;
    color: #A2AFBF;
    background: #151E29;
}
QLabel[state="online"],
QLabel[state="success"] {
    color: #32D583;
}
QLabel[state="warning"] {
    color: #FDB022;
}
QLabel[state="error"] {
    color: #F97066;
}
QLabel[state="muted"],
QLabel[state="offline"] {
    color: #667586;
}
QLabel#athleteIdentityLabel {
    color: #A2AFBF;
    font-size: 15px;
    font-weight: 600;
}
QLabel#athleteIdentityLabel[state="online"],
QLabel#athleteIdentityLabel[state="success"] {
    color: #32D583;
}
QLabel#athleteIdentityLabel[state="warning"] {
    color: #FDB022;
}
QLabel#athleteIdentityLabel[state="error"] {
    color: #F97066;
}
QLabel#athleteIdentityLabel[state="muted"],
QLabel#athleteIdentityLabel[state="offline"] {
    color: #667586;
}

/* Video and camera sources */
VideoOpenGLWidget {
    background: #101720;
    border: 1px solid #202C3A;
    border-radius: 6px;
}
VideoOpenGLWidget[sourceTile="true"] {
    border-radius: 5px;
}
VideoOpenGLWidget[selected="true"] {
    border-color: #38BDF8;
}

/* Training */
QLabel#mainViewTitleLabel {
    font-size: 16px;
}
QLabel#trajectoryTitleLabel,
QLabel#athleteSectionLabel {
    color: #A2AFBF;
    font-size: 12px;
}
QProgressBar {
    min-height: 6px;
    border: none;
    border-radius: 3px;
    background: #202C3A;
}
QProgressBar::chunk {
    border-radius: 3px;
    background: #38BDF8;
}

/* Trajectory */
TrajectoryWidget {
    background: #101720;
}
QFrame#trajectoryToolbar,
QWidget#trajectoryToolbar {
    background: transparent;
}

/* Scrollbars */
QScrollBar:vertical {
    width: 7px;
    margin: 1px;
    background: transparent;
}
QScrollBar:horizontal {
    height: 7px;
    margin: 1px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 24px;
    border-radius: 3px;
    background: #2D4054;
}
QScrollBar::handle:horizontal {
    min-width: 24px;
    border-radius: 3px;
    background: #2D4054;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #3A526B;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: transparent;
}

/* Menus and dialogs */
QMenu {
    padding: 5px;
    border: 1px solid #2D4054;
    border-radius: 6px;
    color: #F4F7FA;
    background: #151E29;
}
QMenu::item {
    min-height: 28px;
    padding: 4px 24px 4px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    color: #F4F7FA;
    background: #1D3042;
}
QMenu::separator {
    height: 1px;
    margin: 5px 4px;
    background: #202C3A;
}
QDialog QLabel {
    color: #F4F7FA;
}
QDialogButtonBox QPushButton {
    min-width: 84px;
}
QHeaderView::section {
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #2D4054;
    color: #A2AFBF;
    background: #151E29;
}
QTableWidget {
    gridline-color: #202C3A;
}
